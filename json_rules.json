{
  "rules": [
    {
      "match": {
        "path_pattern": ".*",
        "methods": ["POST", "PUT", "PATCH"]
      },
      "modifications": [
        { "action": "set", "key_path": "reasoning.enabled",                 "value": true      },
        { "action": "set", "key_path": "reasoning.effort",                  "value": "high"    },
        { "action": "set", "key_path": "thinking.type",                     "value": "enabled" },
        { "action": "set", "key_path": "enable_thinking",                   "value": true      },
        { "action": "set", "key_path": "chat_template_kwargs.enable_thinking", "value": true   },
        { "action": "set", "key_path": "chat_template_kwargs.thinking",     "value": true      }
      ]
    }
  ]
}
